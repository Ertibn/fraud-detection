{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# EDA: Bank Credit Card Data (creditcard.csv)\n",
    "\n",
    "Exploratory analysis of anonymized bank credit card fraud dataset."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8-darkgrid')\n",
    "sns.set_palette('husl')\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load credit card data\n",
    "cc_df = pd.read_csv('../data/creditcard.csv')\n",
    "\n",
    "print(\"Credit Card Data Shape:\", cc_df.shape)\n",
    "print(\"\\nColumns:\", cc_df.columns.tolist())\n",
    "print(\"\\nFirst few rows:\")\n",
    "print(cc_df.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Quality Assessment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data info\n",
    "print(\"Data Info:\")\n",
    "print(cc_df.info())\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "\n",
    "# Missing values\n",
    "print(\"\\nMissing Values:\")\n",
    "missing = cc_df.isnull().sum()\n",
    "print(missing[missing > 0] if missing.sum() > 0 else \"No missing values\")\n",
    "\n",
    "# Duplicates\n",
    "print(f\"\\nDuplicate Records: {cc_df.duplicated().sum()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Basic statistics\n",
    "print(\"Basic Statistics:\")\n",
    "print(cc_df.describe().T)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Target Variable Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Class distribution\n",
    "class_counts = cc_df['Class'].value_counts()\n",
    "class_pct = cc_df['Class'].value_counts(normalize=True) * 100\n",
    "\n",
    "print(\"Target Variable Distribution:\")\n",
    "print(f\"Legitimate (0): {class_counts[0]} ({class_pct[0]:.2f}%)\")\n",
    "print(f\"Fraud (1): {class_counts[1]} ({class_pct[1]:.4f}%)\")\n",
    "print(f\"\\nImbalance Ratio: {class_counts[0] / class_counts[1]:.1f}:1\")\n",
    "\n",
    "# Visualize\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 4))\n",
    "cc_df['Class'].value_counts().plot(kind='bar', ax=ax1, color=['green', 'red'])\n",
    "ax1.set_title('Fraud Distribution (Count)', fontsize=12)\n",
    "ax1.set_xlabel('Class (0=Legitimate, 1=Fraud)')\n",
    "ax1.set_ylabel('Count')\n",
    "ax1.set_xticklabels(['Legitimate', 'Fraud'], rotation=0)\n",
    "\n",
    "cc_df['Class'].value_counts(normalize=True).plot(kind='pie', ax=ax2,\n",
    "                                                   labels=['Legitimate', 'Fraud'],\n",
    "                                                   autopct='%1.3f%%',\n",
    "                                                   colors=['green', 'red'])\n",
    "ax2.set_title('Fraud Distribution (%)', fontsize=12)\n",
    "ax2.set_ylabel('')\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/cc_fraud_distribution.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Amount Feature Analysis"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# Amount statistics\n",
    "print(\"Amount Statistics:\")\n",
    "print(cc_df['Amount'].describe())\n",
    "\n",
    "# By class\n",
    "print(\"\\nAmount by Class:\")\n",
    "print(cc_df.groupby('Class')['Amount'].describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Amount distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "\n",
    "# Legitimate transactions\n",
    "cc_df[cc_df['Class'] == 0]['Amount'].hist(bins=100, ax=axes[0], \n",
    "                                            color='green', alpha=0.7)\n",
    "axes[0].set_title('Amount Distribution: Legitimate Transactions', fontsize=12)\n",
    "axes[0].set_xlabel('Amount ($)')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].set_xlim([0, 500])  # Focus on main range\n",
    "\n",
    "# Fraudulent transactions\n",
    "cc_df[cc_df['Class'] == 1]['Amount'].hist(bins=100, ax=axes[1], \n",
    "                                            color='red', alpha=0.7)\n",
    "axes[1].set_title('Amount Distribution: Fraudulent Transactions', fontsize=12)\n",
    "axes[1].set_xlabel('Amount ($)')\n",
    "axes[1].set_ylabel('Frequency')\n",
    "axes[1].set_xlim([0, 500])  # Focus on main range\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/cc_amount_distribution.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Time Feature Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time statistics\n",
    "print(\"Time Statistics:\")\n",
    "print(cc_df['Time'].describe())\n",
    "\n",
    "# By class\n",
    "print(\"\\nTime by Class:\")\n",
    "print(cc_df.groupby('Class')['Time'].describe())\n",
    "\n",
    "# Calculate time-based features\n",
    "cc_df['hour'] = (cc_df['Time'] // 3600) % 24\n",
    "cc_df['day'] = cc_df['Time'] // 86400"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time distribution\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "\n",
    "# Time (raw)\n",
    "cc_df[cc_df['Class'] == 0]['Time'].hist(bins=50, ax=axes[0], \n",
    "                                          color='green', alpha=0.7, label='Legitimate')\n",
    "cc_df[cc_df['Class'] == 1]['Time'].hist(bins=50, ax=axes[0], \n",
    "                                          color='red', alpha=0.7, label='Fraud')\n",
    "axes[0].set_title('Time Distribution', fontsize=12)\n",
    "axes[0].set_xlabel('Seconds since first transaction')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].legend()\n",
    "\n",
    "# Fraud rate by hour\n",
    "hour_fraud = cc_df.groupby('hour')['Class'].mean() * 100\n",
    "axes[1].plot(hour_fraud.index, hour_fraud.values, marker='o', linewidth=2, markersize=6)\n",
    "axes[1].set_title('Fraud Rate by Hour of Day', fontsize=12)\n",
    "axes[1].set_xlabel('Hour')\n",
    "axes[1].set_ylabel('Fraud Rate (%)')\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/cc_time_analysis.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. PCA Feature Analysis"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# PCA features (V1-V28)\n",
    "pca_features = [col for col in cc_df.columns if col.startswith('V')]\n",
    "\n",
    "print(f\"Number of PCA features: {len(pca_features)}\")\n",
    "print(f\"\\nPCA Feature Names: {pca_features}\")\n",
    "\n",
    "# Statistics\n",
    "print(f\"\\nPCA Features Statistics:\")\n",
    "print(cc_df[pca_features].describe().T.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation of top PCA features with target\n",
    "pca_corr = cc_df[pca_features + ['Class']].corr()['Class'].sort_values(ascending=False)\n",
    "\n",
    "print(\"\\nTop 10 PCA Features by Correlation with Fraud:\")\n",
    "print(pca_corr[1:11])"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# Visualize top PCA features\n",
    "top_pca = pca_corr[1:7].index.tolist()\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
    "axes = axes.ravel()\n",
    "\n",
    "for idx, feature in enumerate(top_pca):\n",
    "    cc_df[cc_df['Class'] == 0][feature].hist(bins=50, ax=axes[idx], \n",
    "                                               color='green', alpha=0.7, label='Legitimate')\n",
    "    cc_df[cc_df['Class'] == 1][feature].hist(bins=50, ax=axes[idx], \n",
    "                                               color='red', alpha=0.7, label='Fraud')\n",
    "    axes[idx].set_title(f'{feature} Distribution', fontsize=10)\n",
    "    axes[idx].legend(fontsize=8)\n",
    "    axes[idx].set_ylabel('Frequency')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/cc_pca_features.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Feature Correlations"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# Correlation matrix\n",
    "corr_matrix = cc_df.corr()\n",
    "fraud_corr = corr_matrix['Class'].sort_values(ascending=False)\n",
    "\n",
    "print(\"\\nTop 15 Features Most Correlated with Fraud:\")\n",
    "print(fraud_corr[1:16])\n",
    "\n",
    "print(\"\\nTop 15 Features Least Correlated with Fraud:\")\n",
    "print(fraud_corr[-15:])"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# Heatmap of top correlated features\n",
    "top_features = fraud_corr[1:11].index.tolist() + ['Class']\n",
    "top_corr = cc_df[top_features].corr()\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(top_corr, annot=True, fmt='.2f', cmap='coolwarm', center=0,\n",
    "            square=True, linewidths=1, cbar_kws={'label': 'Correlation'})\n",
    "plt.title('Top Features Correlation Matrix (Bank Data)', fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.savefig('../notebooks/cc_correlation_matrix.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "## 8. Save Processed Data"
   ]
  },
  {
   "cell_type": {"python", "metadata": {}},
   "source": [
    "# Save processed data\n",
    "cc_df.to_csv('../data/processed/creditcard_processed.csv', index=False)\n",
    "print(\"Saved: creditcard_processed.csv\")\n",
    "print(f\"\\nFinal shape: {cc_df.shape}\")\n",
    "print(f\"Columns: {cc_df.columns.tolist()[:10]}...\")  # Show first 10 columns"
   ]
  }
 ],
